{
  "name": "tower-magnate",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tower-magnate/web dev",
    "build": "pnpm --filter @tower-magnate/web build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm art:build && tsc -b",
    "test": "pnpm art:build && vitest run",
    "test:watch": "vitest",
    "bench:snapshots": "pnpm --filter @tower-magnate/server bench:snapshots",
    "bench:person-view": "pnpm --filter @tower-magnate/server bench:person-view",
    "bench:graph": "tsx scripts/bench-transport-graph.ts",
    "bench:people-layer": "tsx apps/web/src/render/peopleLayer.bench.ts",
    "bench:routes": "tsx scripts/bench-route-planner.ts",
    "art:build": "pnpm --filter @tower-magnate/art build",
    "stack": "tsx scripts/stack.ts",
    "e2e": "playwright test -c e2e",
    "bench:transport": "tsx scripts/bench-transport.ts",
    "bench:people": "node --expose-gc --import tsx scripts/bench-person-pool.ts",
    "bench:events": "tsx scripts/bench-security-events.ts",
    "bench:evaluation": "tsx scripts/bench-unit-evaluation.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tower-magnate/engine": "workspace:*",
    "@tower-magnate/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
