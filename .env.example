# Copy to .env and adjust. Docker Compose and `pnpm stack` both read it.

# Containers, networks and volumes are prefixed with this name.
COMPOSE_PROJECT_NAME=tower-magnate

# dev runs the watched server and the Vite dev server. prod runs the production image.
COMPOSE_PROFILES=dev

# `pnpm stack` maps postgres to PORT_BASE, the server to PORT_BASE + 1 and web to PORT_BASE + 2.
PORT_BASE=4100

# Set any of these to override the port derived from PORT_BASE.
# POSTGRES_PORT=4100
# SERVER_PORT=4101
# WEB_PORT=4102

POSTGRES_USER=tower
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tower_magnate

# The server applies pending migrations on start unless NODE_ENV=production.
# Set to true or false to override. Run them by hand with `pnpm --filter @tower-magnate/server migrate`.
# MIGRATE_ON_START=true

# The session cookie gets the Secure flag when NODE_ENV=production.
# Set to true or false to override, for example false when production runs behind plain http.
# SECURE_COOKIES=false

# Dev watchers use file events. Set to true to poll instead if edits do not reload,
# which can happen when the repo is on a Windows drive and file events do not reach the container.
# Polling costs about 50% of a core for web and 30% for server when idle on Docker Desktop.
# CHOKIDAR_USEPOLLING=false
