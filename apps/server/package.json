{
  "name": "@tower-magnate/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "migrate": "tsx src/migrate.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:fastify --external:@fastify/static --external:pg --outfile=build/main.js"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@tower-magnate/engine": "workspace:*",
    "@tower-magnate/shared": "workspace:*",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
